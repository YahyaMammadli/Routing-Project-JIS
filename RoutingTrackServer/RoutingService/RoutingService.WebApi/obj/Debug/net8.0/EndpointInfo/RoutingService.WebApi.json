{
  "openapi": "3.0.1",
  "info": {
    "title": "RoutingService.WebApi",
    "version": "1.0"
  },
  "paths": {
    "/api/Route/calculate": {
      "post": {
        "tags": [
          "Route"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/MultiProviderRouteResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiProviderRouteResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiProviderRouteResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracked-routes": {
      "get": {
        "tags": [
          "TrackedRoutes"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "TrackedRoutes"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTrackedRouteDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTrackedRouteDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTrackedRouteDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tracked-routes/{id}": {
      "delete": {
        "tags": [
          "TrackedRoutes"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tracked-routes/{id}/history": {
      "get": {
        "tags": [
          "TrackedRoutes"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tracked-routes/run-now": {
      "post": {
        "tags": [
          "TrackedRoutes"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTrackedRouteDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "nullable": true
          },
          "to": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MultiProviderRouteResult": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "nullable": true
          },
          "to": {
            "type": "string",
            "nullable": true
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderRouteResult"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProviderRouteResult": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "nullable": true
          },
          "transportMode": {
            "type": "string",
            "nullable": true
          },
          "distanceKm": {
            "type": "number",
            "format": "double"
          },
          "durationMinutes": {
            "type": "number",
            "format": "double"
          },
          "durationWithoutTrafficMinutes": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "trafficAvailable": {
            "type": "boolean"
          },
          "trafficUsed": {
            "type": "boolean"
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RouteRequestDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "nullable": true
          },
          "to": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}